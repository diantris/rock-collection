# Copy this file to .env (which git ignores) and fill in the values.
# docker compose reads .env automatically. Never commit the real token.

# Fine-grained personal access token, limited to the Pages repo, permission Contents: Read and write
GITHUB_TOKEN=
# The public repo the site and full-size photos are pushed to
GITHUB_PAGES_REPO=diantris/rock-collection-page
GITHUB_PAGES_BRANCH=main

# deploy/.env - The VM's settings and secrets. setup-vm.sh copies this file to .env (which git ignores) and fills in
# POSTGRES_PASSWORD; fill in the rest with `nano .env`. Changes apply within 5 minutes (update.sh).

# DuckDNS (https://www.duckdns.org): the subdomain without .duckdns.org, and the token shown on the DuckDNS page.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Fine-grained GitHub token for publishing: only the Pages repo (diantris/rock-collection-page), permission
# Contents: Read and write. Best a new one just for the VM, so it can be revoked on its own.
GITHUB_TOKEN=

# Cloud Storage bucket for the nightly database backups, without gs:// (empty = no backups).
BACKUP_BUCKET=

# The database password. setup-vm.sh generates it; don't change it once the database exists (Postgres keeps the first).
POSTGRES_PASSWORD=

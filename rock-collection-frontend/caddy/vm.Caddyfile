# vm.Caddyfile - The cloud VM (deploy/README.md): HTTPS for <DUCKDNS_DOMAIN>.duckdns.org with a Let's Encrypt
# certificate, obtained and renewed by Caddy through a DNS record at DuckDNS (the firewall lets only the home IP in,
# so Let's Encrypt can't check the VM itself). Plain HTTP redirects to HTTPS. Certificates are kept in /data.
{
	servers {
		# No HTTP/3: it needs UDP port 443, which the firewall doesn't open.
		protocols h1 h2
	}
}

{$DUCKDNS_DOMAIN}.duckdns.org {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}
	import /etc/caddy/app.caddy
}

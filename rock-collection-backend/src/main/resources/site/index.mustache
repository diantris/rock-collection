<!doctype html>
<html lang="en">
<head>
{{> head}}
</head>
<body>
<main class="page">
  <header class="site-header">
    <h1>Rock Collection</h1>
    {{#intro}}
    <p class="intro">{{.}}</p>
    {{/intro}}
    <p class="stats">{{countLabel}}{{#statusCounts}} · {{summary}}{{/statusCounts}}</p>
  </header>

  {{#hasCards}}
  <div class="toolbar" data-filters hidden>
    <input type="search" class="search" placeholder="Search by name{{#showIdentity}} or material{{/showIdentity}}, or #number" aria-label="Search specimens" data-filter-search>
    {{#showStatus}}
    <label class="sort">Status
      <select data-filter-status>
        <option value="">All</option>
        {{#statusCounts}}<option value="{{key}}">{{label}} ({{count}})</option>{{/statusCounts}}
      </select>
    </label>
    {{/showStatus}}
    <label class="sort">Sort by
      <select data-sort>
        <option value="">Featured first</option>
        <option value="name">Name, A–Z</option>
        <option value="number">Number, lowest first</option>
        <option value="newest">Newest first</option>
      </select>
    </label>
    <span class="toolbar-count" aria-live="polite" data-filter-count></span>
  </div>
  {{/hasCards}}

  <ul class="cards">
    {{#cards}}
    <li class="card" data-id="{{id}}" data-search="{{search}}" data-status="{{status}}">
      <a href="{{href}}">
        {{#image}}<img class="card-image" src="{{.}}" alt="" loading="lazy">{{/image}}
        {{^image}}<span class="card-image card-image-empty" aria-hidden="true"></span>{{/image}}
        <span class="card-body">
          <span class="card-name">{{name}}</span>
          {{#whySpecial}}<span class="card-why">{{.}}</span>{{/whySpecial}}
        </span>
      </a>
    </li>
    {{/cards}}
  </ul>
  {{^cards}}
  <p class="empty">Nothing has been published yet.</p>
  {{/cards}}
  <p class="empty" data-filter-empty hidden>No specimens match.</p>
</main>
<script src="assets/site.js"></script>
</body>
</html>
